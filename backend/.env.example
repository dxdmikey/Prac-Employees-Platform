# ---------------------------------------------------------------------------
# Backend environment example.
#
# Copy this file to "backend/.env" and put YOUR OWN local values in it:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# ".env" is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

APP_NAME=employee-platform-backend
APP_ENV=local

# PostgreSQL connection string used by both SQLAlchemy and Alembic.
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
#   postgresql+psycopg  -> PostgreSQL via the psycopg 3 driver
#   employee_platform   -> the database this project uses
# Replace username and password with your local PostgreSQL credentials.
#
# IMPORTANT: a password containing special characters must be percent-encoded,
# because they otherwise change the meaning of the URL:
#   @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F    % -> %25
# For example the password "pa@ss" is written pa%40ss. Without this, the text
# after @ is read as the host name and the connection fails.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/employee_platform

# Set to true to make SQLAlchemy print every SQL statement it runs.
# Useful while learning; leave false for normal work.
DB_ECHO=false

# How long a login token stays valid, in minutes. 480 = 8 hours.
AUTH_TOKEN_EXPIRE_MINUTES=480

# Used ONLY by scripts/create_admin_user.py to create the local admin account.
# Leave it commented out and the script asks for the password at a hidden
# prompt instead, which keeps it out of your shell history and out of .env.
# Never commit a real password.
# ADMIN_PASSWORD=change-me-locally
