# ---------------------------------------------------------------------------
# Employee Platform Demo - example environment file
#
# Copy this file to ".env" and adjust the values for your machine.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# ".env" is git-ignored on purpose - never commit real secrets.
# Only the variables actually used by the current stage are listed here.
# More variables (database, Azure, ETL) will be added in later stages.
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ---
APP_NAME=employee-platform-backend
APP_ENV=local
# The backend's host and port are given on the uvicorn command line
# (see README), not read from here.

# The PostgreSQL connection string lives in backend/.env
# (see backend/.env.example). It is kept there because both the FastAPI app
# and Alembic read it from that folder.

# --- Frontend (Vite) ---
# Only variables prefixed with VITE_ are exposed to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
